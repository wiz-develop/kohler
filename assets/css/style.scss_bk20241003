$main-color-black: #000000;
$main-color-blue: #04202e;
$sub-color: #ffffff;
$mg-color: #F6F6F6;
$box-shadow: 0 .5rem 1rem rgba(0,0,0,.10);
$border-color: #EBEBEB;

$col-xxl: 1401px;
$col-xl: 1201px;
$col-lg: 993px;
$col-md: 769px;
$col-sm: 577px;

@mixin col-xxl {
    @media (max-width: ($col-xxl)) {
      @content;
    }
}
@mixin col-xl {
  @media (max-width: ($col-xl)) {
    @content;
  }
}
@mixin col-lg {
  @media (max-width: ($col-lg)) {
    @content;
  }
}
@mixin col-md {
  @media (max-width: ($col-md)) {
    @content;
  }
}
@mixin col-sm {
  @media (max-width: ($col-sm)) {
    @content;
  }
}

/* --------------------------------
	アニメーション
-------------------------------- */
@keyframes slide_down_up {
	0% {
	  transform: translateY(-80px);
	  opacity: 0;
	}
	100% {
	  transform: translateY(0);
	}
	40%,100% {
	  opacity: 1;
	}
}

.anime {
	opacity: 0;
    &.is-animated {
		animation: slide_down_up 2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }
}
.anime_zoom_merit {
    transform: scale(0);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.5s, opacity 0.5s, visibility 0.5s;
    &.active {
        opacity: 1;
        visibility: visible;
        transform: scale(1);
    }
}

/* --------------------------------
	サイト基本設定
-------------------------------- */
html,body,div,p {
    letter-spacing: .01rem;
}
html {
    scroll-behavior: smooth;
}
body {
    display: flex;
    display: -webkit-flex;
    display: -ms-flexbox;
    flex-direction: column;
    min-height: 100vh;
    #content {
        flex: 1;
    }
}
h1,h2,h3,h4,h5,p {
	font-weight: 500;
}
h1 {
    &:before {
        display: none !important;
    }
}
h2 {
    &:before {
        display: none;
    }
}
button {
	border: 0;
}
.sp-br {
	display: none;
	@include col-lg {
		display: block;
	}
}
.pc-br {
	display: block;
	@include col-lg {
		display: none;
	}
}
.content-tit {
	margin-bottom: 4rem;
}
section {
	padding: 4rem 0;
	@include col-lg {
		padding: 3.5rem 0;
	}
	@include col-sm {
		padding: 2.5rem 0;
	}
}
p {
	font-size: .75rem;
}
.txt-black {
	color: black !important;
}
.txt-white {
	color: white !important;
}
.slick-arrow {
	position: absolute;
	bottom: 0;
	top: 0;
	margin: auto;
	z-index: 1;
	background: none;
	border: 0;
	&:hover,
	&:focus {
		background-color: transparent !important;
	}
	@include col-lg {
		padding: 0 .75rem;
	}
	@include col-sm {
		width: 80px;
	}
	i {
		font-size: 4rem;
		background-color: white;
		border-radius: 100%;
		@include col-lg {
		font-size: 5rem;
		}
		@include col-sm {
		font-size: 3.5rem;
		}
	}
	&.slick-disabled {
		i {
		color: #b2adaf;
		}
	}
}
.prev-btn {
		left: 6%;
	@include col-lg {
		left: 4%;
	}
	@include col-sm {
		left: -4%;
	}
}
.next-btn {
	right: 6%;
	@include col-lg {
		right: 4%;
	}
	@include col-sm {
		right: 4%;
	}
}
.slick-track {
	display: flex !important;
}
.slick-slide {
	height: auto !important;
}
@keyframes progress {
	from {
	  width: 0%;
	}
  
	to {
	  width: 100%;
	}
}
.slider-dots {
	width: 100%;
	margin: 0;
	padding: 0;
	text-align: center;
	list-style: none;
	margin-top: .25rem;
	.slick-active {
		button {
			&::after {
				background-color: #000;
		  		animation: progress 5.5s linear forwards;
			}
		}
	}
	li {
		display: inline-block;
		width: calc(12% - 8px);
    	margin: 0 .25rem;
		@include col-sm {
			width: calc(13.5% - 8px);
		}
	}
	button {
		position: relative;
		width: 100%;
		height: 1rem;
		border: 0;
		background-color: #ccc;
		font-size: 0;
		&:after {
			position: absolute;
			top: 0;
			left: 0;
			content: "";
			display: block;
			width: 0%;
			height: 100%;
		}
	}
}
.modal_box {
    display: none;
}
.modal_bg {
    background-color: rgba(30, 30, 30, 0.65);
    height: 100%;
    width: 100%;
}
.modal_inner {
    background-color: #fff;
    padding: 3rem;
    position: absolute;
    width: 75%;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: auto;
    max-height: 75%;
    @include col-md {
      width: 85%;
      max-height: 85%;
    }
    @include col-sm {
      width: 90%;
      padding: 25px;
    }
}
.modal_block {
    max-height: calc(100% - 1.5rem);
    overflow-y: scroll;
    -ms-overflow-style: none;
    scrollbar-width: none;
    padding-bottom: 3rem;
    @include col-sm {
        max-height: calc(100% - 2.5rem);
    }
    &::-webkit-scrollbar {
        display: none;
    }
    &::after {
        display: block;
        position: absolute;
        bottom: 3.5rem;
        left: 0;
        content: "";
        width: 100%;
        height: 60px;
        background: -webkit-linear-gradient(top, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.9) 50%, rgba(255, 255, 255, 0.9) 50%, #fff 100%);
    }
}

