	.faq-list {
		padding: 0;
		&__content {
			background: url(../img/common/question-icon.png) no-repeat 0 0 #f4f8ff;
			background-size: 50px 47px;
			-webkit-transition: all 0.3s cubic-bezier(0.39, 0.575, 0.565, 1);
			transition: all 0.3s cubic-bezier(0.39, 0.575, 0.565, 1);
			background-size: 2rem;
			margin-bottom: .5rem;
			.ac-parent,
			.ac-child {
				text-align: left;
				font-size: 1.5rem;
			}
			.ac-parent {
				position: relative;
				cursor: pointer;
				padding: .5rem 2.5rem;
				height: auto;
				border: none;
				&:after {
					content: "";
					display: inline-block;
					position: absolute;
					top: 45%;
					right: 30px;
					width: 10px;
					height: 10px;
					transition: .3s;
					border-right: 3px solid #263546;
					border-bottom: 3px solid #263546;
					transform: translateY(-50%) rotate(45deg);
				}
				&.open {
					&:after {
						transform: rotate(225deg);
					}
				}
			}
			.ac-child {
				background-color: transparent;
				padding: 0 2.5rem .5rem 2.5rem;
				.answer {
					display: -webkit-flex;
					display: -ms-flexbox;
					align-items: baseline;
