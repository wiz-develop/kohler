		}
		.product-link_list {
			&__item {
				img {
					object-fit: cover;
					width: 100%;
					height: 12vh;
				}
				&__name {
					.parent-tit__link {
						border: 0;
						padding-bottom: 0;
						i {
							font-size: .5rem;
						}
					}
				}
			}
		}
		&__list {
			overflow: hidden;
			font-size: .9rem;
			font-weight: 500;
			@include col-lg {
			overflow: hidden;
			border-bottom: 1px solid white;
			}
			a {
				color: white;
				font-size: .75rem;
				&:hover {
					cursor: pointer;
				}
			}
			&.sub-menu_sp {
				display: none;
				@include col-lg {
					display: block;
				}
			}
			.parent-tit__link {
				border-bottom: solid 1px white;
				padding-bottom: .5rem;
				.link-arrow {
					width: 1rem;
				}
			}
			&__link {
				border-bottom: solid 1px white;
				padding-bottom: .5rem;
				.link-arrow {
					width: 1rem;
				}
			}
		}
		}
		&__parent {
		&__link {
			padding-left: 1.2rem;
			@include col-lg {
			border-bottom: 1px solid lightgray;
			}
			&:not(.js-menu_child_open)::after {
			@include col-lg {
				content: "";
				right: 2rem;
				background: none;
				transform: rotate(45deg);
				width: 10px;
				height: 10px;
				border-top: 2px solid $main-color-black;
				border-right: 2px solid $main-color-black;
				position: absolute;
				top: 0;
				bottom: 0;
				margin: auto;
			}
			}
			div {
				p {
					font-weight: bold;
					letter-spacing: .05rem;
					font-size: 1.2rem;
					-webkit-text-stroke: 0;
					&:last-child {
						padding-top: .25rem;
						font-weight: bold;
						font-size: .75rem;
						@include col-lg {
							padding-top: 0;
						}
					}
				}
			}
			.open-icon, .close-icon {
			display: none;
			}
			&.js-menu_child_open {
			.open-icon {
				display: block;
			}
			.close-icon {
				display: none;
			}
			}
			&.js-open {
			.open-icon {
				display: none;
			}
			.close-icon {
				display: block;
			}
			}
		}
		&__list {
			a {
				&:hover {
					cursor: pointer;
				}
			}
			div {
				&:hover {
					cursor: pointer;
				}
			}
			&:first-child {
				display: none;
				@include col-lg {
					display: block;
				}
			}
			&:nth-last-child() {
			.menu-list__parent__link {
				padding-right: 0;
			}
			}
			&:hover {
				cursor: pointer;
				.menu-list__child {
				opacity: 1;
				visibility: visible;
				}
			}
			&:last-child {
				background: $main-color-black;
				margin-left: 1rem;
				padding: .5rem 1rem;
				button {
					background: none;
					padding: 0;
